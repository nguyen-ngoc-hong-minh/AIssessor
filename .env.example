# Public application
APP_URL=
NEXT_PUBLIC_APP_URL=

# Clerk (frontend host)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_WEBHOOK_SYNC_KEY=

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_HTTP_ACTIONS_URL=
CONVEX_DEPLOYMENT=

# Set these in the Convex deployment environment as well
CLERK_JWT_ISSUER_DOMAIN=
EVIDENCE_ADMIN_EMAILS=

# Planner provider - Convex Actions only. Gemini takes precedence when either
# GEMINI variable is present and offers a limited free tier for small projects.
GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=
# Optional paid OpenAI fallback.
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=

# Live model sources
ARTIFICIAL_ANALYSIS_API_KEY=
# Optional for the public models endpoint; set only if your OpenRouter account requires it.
OPENROUTER_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# Optional credentialed E2E gates
E2E_BASE_URL=
E2E_CLERK_CONFIGURED=
E2E_CLERK_TEST_USER=
E2E_STRIPE_TEST_MODE=
